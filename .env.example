ANTHROPIC_API_KEY=sk-ant-...

# Which model does what (all optional).
# Default for judgements, events, company genesis and epilogues:
# CEO_MODEL=claude-sonnet-5-5
# Default for flavour text (gossip, ghostwriter, shop catalogues, candidates):
# CEO_FAST_MODEL=claude-haiku-5-5
# Per-task overrides win over both:
# CEO_MODEL_JUDGE=      every free-text judgement (all-hands, pitch, 1:1s, board, Brunner...)
# CEO_MODEL_EVENT=      quarterly events and storylines
# CEO_MODEL_GENESIS=    the new company and its first team
# CEO_MODEL_EPILOGUE=   how the world remembers you
# CEO_MODEL_GOSSIP=     office gossip
# CEO_MODEL_GHOSTWRITE= the ghostwriter
# CEO_MODEL_LIFESTYLE=  lifestyle picks
# CEO_MODEL_PERKS=      office-shop specials
# CEO_MODEL_CANDIDATES= job candidates
